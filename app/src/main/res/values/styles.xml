<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Popup Menu -->
    <style name="PopupMenu" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/dark_gray</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

    <!-- Settings -->
    <style name="SettingSection"/>

    <style name="SettingSection.Container">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SettingSection.Name">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingItem"/>

    <style name="SettingItem.Container">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="SettingItem.Name">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

    <style name="SettingItem.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="SettingItem.Checkbox">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:buttonTint">@color/light_gray</item>
    </style>

    <style name="SettingItem.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/shape_rounded_square</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_medium_small</item>
    </style>

    <!-- EditText -->
    <style name="EditText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:backgroundTint">@color/light_gray</item>
        <item name="android:textColorHint">@color/light_gray</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

    <!-- Date Picker-->
    <style name="DatePickerDialog" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:datePickerStyle">@style/DatePicker</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/darker_gray</item>
        <!-- Header Active, Month and Dates -->
        <item name="android:textColorPrimary">@color/white</item>
        <!-- Header Inactive and Weekdays -->
        <item name="android:textColorSecondary">@color/purple</item>
        <!-- Selector and Current Date -->
        <item name="android:colorControlActivated">@color/purple</item>
        <!-- Selected Date -->
        <item name="android:textColorPrimaryInverse">@color/white</item>
        <!-- Buttons -->
        <item name="colorPrimary">@color/purple</item>
    </style>

    <style name="DatePicker" parent="@android:style/Widget.Material.DatePicker">
        <!-- Header Background -->
        <item name="android:headerBackground">@color/dark_gray</item>
    </style>

    <!-- Time Picker -->
    <style name="TimePickerDialog" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:timePickerStyle">@style/TimePicker</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/darker_gray</item>
        <!-- Header Active and Time Input-->
        <item name="android:textColorPrimary">@color/white</item>
        <!-- Header Inactive and Change View Button -->
        <item name="android:textColorSecondary">@color/purple</item>
        <!-- Text -->
        <item name="android:textColor">@color/white</item>
        <!-- Time Hint -->
        <item name="android:textColorHint">@color/light_gray</item>
        <!-- Buttons -->
        <item name="colorPrimary">@color/purple</item>
    </style>

    <style name="TimePicker" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">clock</item>
        <!-- Header Background -->
        <item name="android:headerBackground">@color/dark_gray</item>
        <!-- Dial -->
        <item name="android:numbersBackgroundColor">@color/dark_gray</item>
        <!-- Selector -->
        <item name="android:numbersSelectorColor">@color/purple</item>
        <!-- Outer Numbers -->
        <item name="android:numbersTextColor">@color/white</item>
        <!-- Inner Numbers -->
        <item name="android:numbersInnerTextColor">@color/light_gray</item>
    </style>
</resources>